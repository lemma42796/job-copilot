{
  "name": "jobcopilot",
  "version": "0.0.1",
  "private": true,
  "description": "JobCopilot — AI 求职副驾(monorepo root)",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter @jobcopilot/web dev",
    "gen:api": "pnpm --filter @jobcopilot/schemas gen",
    "test": "pnpm -r --parallel test",
    "test:e2e": "pnpm --filter @jobcopilot/web test:e2e",
    "eval:jd": "pnpm --filter @jobcopilot/evals run eval:jd",
    "eval:view": "pnpm --filter @jobcopilot/evals run eval:view"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "5.6.3"
  }
}
