{
  "name": "@jobcopilot/evals",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "eval:jd": "promptfoo eval -c suites/jd_extract/promptfooconfig.yaml --output reports/jd-latest.json",
    "eval:profile": "promptfoo eval -c suites/profile_extract/promptfooconfig.yaml --output reports/profile-latest.json",
    "eval:view": "promptfoo view",
    "prep:screenshot": "tsx scripts/from-screenshot.ts",
    "prep:synth": "tsx scripts/synth-seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openai": "4.77.0",
    "promptfoo": "0.121.9"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
