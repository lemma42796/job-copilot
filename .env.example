# JobCopilot — copy to `.env` and fill in.
# `docker compose up -d` reads this file via the env_file convention.

# ───────── LLM Provider ─────────
# 主:阿里云百炼(申请:https://bailian.console.aliyun.com/)
DASHSCOPE_API_KEY=sk-replace-me
LLM_PROVIDER=dashscope    # dashscope | deepseek

# 备选:DeepSeek(¥15 阿里云余额耗尽后切换,见 ADR-0001)
# DEEPSEEK_API_KEY=sk-replace-me

# ───────── 运行环境 ─────────
JOBCOPILOT_ENV=dev        # dev | prod | test
# 可选:逻辑 notes/ 对应的本地笔记目录;留空时 dev 优先用 test-notes/llm-notes,否则用 ./notes
# JOBCOPILOT_NOTES_FS_ROOT=test-notes/llm-notes
